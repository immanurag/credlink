# ---- Database ----
DB_USER=credlink
DB_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# ---- JWT ----
# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# ---- OTP email delivery ----
# OTP_MODE=mock  -> no email is sent; the OTP is printed to the BACKEND CONSOLE only (local/dev use)
# OTP_MODE=live  -> a real 6-digit OTP is emailed via SMTP; it is never logged or returned by the API
OTP_MODE=mock

# SMTP settings - only required when OTP_MODE=live. Leave SMTP_PASSWORD empty in mock mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP account used to authenticate with the mail server
SMTP_USERNAME=
# For Gmail: do NOT use your normal Gmail password - generate a Google "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords) and use that here.
SMTP_PASSWORD=
# "From" address shown to the merchant. Falls back to SMTP_USERNAME if left blank.
SMTP_FROM=

# ---- NLP / LLM extraction ----
# mode=mock uses the built-in rule-based Hindi/Hinglish parser, no API key needed
LLM_MODE=mock
LLM_API_KEY=
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openai/gpt-4o-mini

# ---- Notifications (Twilio) ----
# mode=mock logs what would be sent instead of calling Twilio
NOTIFY_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
